# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg
.eggs/

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Virtual environments
.venv/
venv/
ENV/

# IDE / editor files
.vscode/
.idea/
.project
.pydevproject
*.swp
*.swo
*~

# pytest / coverage
.pytest_cache/
.coverage
htmlcov/

# mypy
.mypy_cache/

# Sphinx documentation build
docs/_build/

# Backup files
*.backup

# OS files
.DS_Store
Thumbs.db

# Environment variables
.env

# Regression suite: large inference goldens are kept out of git; regenerate
# with scripts/regenerate_regression_baselines.py or stash on shared storage.
tests/regression/fixtures/*/inference.csv
# Regression test slides (large binaries; keep on disk, not in git)
tests/cases/*.svs
tests/cases/*.tiff
tests/cases/*.tif

# Generated by setuptools_scm (write_to); never committed.
wsinsight/_version.py

# One-off HuggingFace model snapshots: the folder is the snapshot root
# (pytorch_model.bin is multi-GB). Regenerate via the download script —
# the artefact does not belong in the repo.
hoptimus/

# Shell/editor dotfiles that the dev container mounts at the repo root. They
# belong to the user's home, not to this project, and .gitconfig/.mcp.json can
# carry credentials — "Stage All Changes" picks them up otherwise.
/.bash_profile
/.bashrc
/.gitconfig
/.profile
/.ripgreprc
/.zprofile
/.zshrc
/.idea
/.mcp.json

# Local reference copy of the pre-tilefuse2 stitcher, kept for A/B runs only.
/wsinsight/modellib/tilefuse_baseline_912ff81.py
